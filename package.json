{
  "name": "workspace",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed": "pnpm --filter @workspace/scripts run db:seed",
    "db:verify": "pnpm --filter @workspace/scripts run db:verify",
    "test:crm": "tsx --test tests/company-crm.test.ts tests/company-migration.test.ts",
    "test:contacts": "tsx --tsconfig artifacts/leadgen/tsconfig.test.json --test tests/contact-display.test.ts tests/segment-filters.test.ts tests/api-cache.test.ts artifacts/leadgen/tests/contact-grid.test.tsx",
    "typecheck:api": "tsc -p api/tsconfig.json --noEmit",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pg": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "25.3.3",
    "@types/pg": "^8.20.0",
    "prettier": "^3.8.4",
    "tsx": "4.21.0",
    "typescript": "~5.9.3"
  }
}
