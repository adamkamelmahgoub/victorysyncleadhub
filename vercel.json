{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/leadgen build",
  "outputDirectory": "artifacts/leadgen/dist/public",
  "routes": [
    { "src": "^/api/assistant$", "dest": "/api/assistant.ts" },
    { "src": "^/leadgen/api/assistant$", "dest": "/api/assistant.ts" },
    { "src": "^/api/enrichment$", "dest": "/api/enrichment.ts" },
    { "src": "^/api/enrichment-worker$", "dest": "/api/enrichment-worker.ts" },
    { "src": "^/api/social-webhook$", "dest": "/api/social-webhook.ts" },
    { "src": "^/api/social-worker$", "dest": "/api/social-worker.ts" },
    { "src": "^/api/social$", "dest": "/api/social.ts" },
    { "src": "^/api/social-bulk$", "dest": "/api/social-bulk.ts" },
    { "src": "^/api/social-inbox$", "dest": "/api/social-inbox.ts" },
    { "src": "^/api/social-draft$", "dest": "/api/social-draft.ts" },
    { "src": "^/api/social-reply$", "dest": "/api/social-reply.ts" },
    { "src": "^/api/social-accounts$", "dest": "/api/social-accounts.ts" },
    { "src": "^/api/social-daily$", "dest": "/api/social-daily.ts" },
    { "src": "^/api/dm-queue$", "dest": "/api/dm-queue.ts" },
    { "src": "^/api/dm-campaigns$", "dest": "/api/dm-campaigns.ts" },
    { "src": "^/api/mcp$", "dest": "/api/mcp.ts" },
    { "src": "^/\\.well-known/oauth-(protected-resource|authorization-server)$", "dest": "/api/mcp.ts" },
    { "src": "^/(authorize|token|register|revoke)$", "dest": "/api/mcp.ts" },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "src": "/leadgen/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    { "path": "/api/social-worker", "schedule": "*/5 * * * *" },
    { "path": "/api/social-daily", "schedule": "0 5 * * *" }
  ]
}
