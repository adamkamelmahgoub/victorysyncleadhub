{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/leadgen build",
  "outputDirectory": "artifacts/leadgen/dist/public",
  "crons": [
    { "path": "/api/client-delivery-worker", "schedule": "0 0 * * *" }
  ],
  "routes": [
    { "src": "^/api/portal$", "dest": "/api/portal.ts" },
    { "src": "^/leadgen/api/portal$", "dest": "/api/portal.ts" },
    { "src": "^/api/client-stripe-webhook$", "dest": "/api/client-stripe-webhook.ts" },
    { "src": "^/api/client-delivery-worker$", "dest": "/api/client-delivery-worker.ts" },
    { "src": "^/api/public/(?:landing|forms)/[^/]+$", "dest": "/api/client-landing.ts" },
    { "src": "^/api/assistant$", "dest": "/api/assistant.ts" },
    { "src": "^/leadgen/api/assistant$", "dest": "/api/assistant.ts" },
    { "src": "^/api/enrichment$", "dest": "/api/enrichment.ts" },
    { "src": "^/api/enrichment-worker$", "dest": "/api/enrichment-worker.ts" },
    { "src": "^/(?:api/(?:forms|landing-pages)(?:/.*)?|api/marketing/reports|f/[a-z0-9-]+|p/[a-z0-9-]+)$", "dest": "/api/marketing.ts" },
    { "src": "^/(?:leadgen/)?api/(?:social(?:-[a-z]+)*|dm-(?:queue|campaigns))$", "dest": "/api/social-router.ts" },
    { "src": "^/api/mcp$", "dest": "/api/mcp.ts" },
    { "src": "^/\\.well-known/oauth-(protected-resource|authorization-server)$", "dest": "/api/mcp.ts" },
    { "src": "^/(authorize|token|register|revoke)$", "dest": "/api/mcp.ts" },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "src": "/leadgen/api/(.*)",
      "dest": "/api/[...path].ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
