# ── Required ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/victorysync
SESSION_SECRET=replace_with_a_random_64_character_string
PORTAL_COOKIE_SECRET=replace_with_another_random_64_character_string
PORT=8080
NODE_ENV=production
APP_URL=https://yourdomain.com

# Supabase
# Use the project API URL and anon key from Supabase Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REQUIRED=true
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Client portal, billing, delivery, and page assistant
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
INVITE_FROM_EMAIL=
REPORT_FROM_EMAIL=
MIGHTYCALL_API_KEY=
MIGHTYCALL_SECRET_KEY=
OPENROUTER_LANDING_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
SLACK_WEBHOOK_URL=
CRON_SECRET=

# Keep public Supabase Auth signups disabled. New users should be created through
# admin-issued invite codes in the app.

# ── Google / Gmail OAuth ───────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Gmail API + Google Business Profile API
# Authorized redirect URI: https://yourdomain.com/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook / Instagram OAuth ────────────────────────────────────────────────
# Get from: https://developers.facebook.com/apps
# Products needed: Facebook Login, Messenger, Instagram Basic Display
# Authorized redirect URI: https://yourdomain.com/api/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Slack OAuth ────────────────────────────────────────────────────────────────
# Get from: https://api.slack.com/apps
# Authorized redirect URI: https://yourdomain.com/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── LinkedIn OAuth ─────────────────────────────────────────────────────────────
# Get from: https://www.linkedin.com/developers/apps
# Authorized redirect URI: https://yourdomain.com/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Calendly OAuth ─────────────────────────────────────────────────────────────
# Get from: https://developer.calendly.com
# Authorized redirect URI: https://yourdomain.com/api/oauth/calendly/callback
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Outreach email: configure on the server only. See docs/OUTREACH_PHASE2.md.
OUTREACH_EMAIL_ENABLED=false
OUTREACH_PUBLIC_URL=https://crm.example.com
OUTREACH_ENCRYPTION_KEY_ID=v1
# JSON map of key IDs to base64-encoded, randomly generated 32-byte keys.
OUTREACH_ENCRYPTION_KEYS={}
OUTREACH_WORKER_TOKEN=
OUTREACH_EVENT_SECRET=
RESEND_WEBHOOK_SECRET=
ZEROBOUNCE_API_KEY=
