# ── Required ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/victorysync
SESSION_SECRET=replace_with_a_random_64_character_string
PORT=8080
NODE_ENV=production
APP_URL=https://yourdomain.com

# Supabase
# Use the project API URL and anon key from Supabase Project Settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REQUIRED=true
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Google / Gmail OAuth ───────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Gmail API + Google Business Profile API
# Authorized redirect URI: https://yourdomain.com/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook / Instagram OAuth ────────────────────────────────────────────────
# Get from: https://developers.facebook.com/apps
# Products needed: Facebook Login, Messenger, Instagram Basic Display
# Authorized redirect URI: https://yourdomain.com/api/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Slack OAuth ────────────────────────────────────────────────────────────────
# Get from: https://api.slack.com/apps
# Authorized redirect URI: https://yourdomain.com/api/oauth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── LinkedIn OAuth ─────────────────────────────────────────────────────────────
# Get from: https://www.linkedin.com/developers/apps
# Authorized redirect URI: https://yourdomain.com/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Calendly OAuth ─────────────────────────────────────────────────────────────
# Get from: https://developer.calendly.com
# Authorized redirect URI: https://yourdomain.com/api/oauth/calendly/callback
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
